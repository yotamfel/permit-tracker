{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "myslotscout.com" }],
      "destination": "https://www.myslotscout.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/sitemap.xml", "destination": "https://permit-tracker-production-d4cf.up.railway.app/sitemap.xml" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
