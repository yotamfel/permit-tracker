VITE_API_URL=http://localhost:8000
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Paddle client-side token (safe to expose - not the secret server API key).
# VITE_PADDLE_ENVIRONMENT=sandbox while testing; unset/anything else for production.
VITE_PADDLE_CLIENT_TOKEN=test_...
VITE_PADDLE_ENVIRONMENT=sandbox
# Optional - Google Analytics 4 measurement ID (Admin > Data Streams in GA).
# Leave unset to disable analytics entirely (e.g. local dev).
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
