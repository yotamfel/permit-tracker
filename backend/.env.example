DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require
PADDLE_API_KEY=...
PADDLE_WEBHOOK_SECRET=...
PADDLE_PRICE_ID=pri_...
# Sandbox: https://sandbox-api.paddle.com. Defaults to the production API.
PADDLE_API_BASE_URL=https://api.paddle.com
EMAIL_PROVIDER_API_KEY=re_...
EMAIL_FROM=alerts@yourdomain.com
JWT_SECRET=change-me-to-a-long-random-string
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Optional - error monitoring. Leave SENTRY_DSN unset to disable entirely.
SENTRY_DSN=
ENVIRONMENT=production
